{
  "permissions": {
    "allow": [
      "*",
      "Bash(dotnet test:*)",
      "Bash(dotnet build:*)",
      "Bash(dotnet restore:*)",
      "Bash(dotnet list:*)",
      "Bash(xargs basename:*)",
      "Bash(timeout 30 dotnet test:*)",
      "Bash(timeout 20 dotnet test:*)"
    ],
    "deny": [],
    "ask": []
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "echo '\n📚 Remember to review:\n- docs/*.md\n- .claude/agents/*.md\n- .claude/prompts/README.md'"
          }
        ]
      }
    ]
  },
  "defaultMode": "bypassPermissions"
}
